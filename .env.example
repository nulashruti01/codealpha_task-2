# This repository uses separate packages for backend and frontend.
# Use the package-specific examples in backend/.env.example and frontend/.env.example.

# Frontend URL used during local development:
NEXT_PUBLIC_API_URL=http://localhost:3333

# Backend database config should be set in backend/.env or on Render / Atlas.
# Example MongoDB Atlas URL for backend:
# DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/flowboard?retryWrites=true&w=majority
# JWT_SECRET=your_jwt_secret_here
